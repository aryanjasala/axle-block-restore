{
  "$comment": "Screens tests/e2e/a11y.spec.js checks with axe-core. This file belongs to the plugin: apply-template.py only writes it when it is missing. The fields are described in docs/DEVELOPMENT.md.",
  "include": [".abr-modal"],
  "exclude": [],
  "screens": [
    {
      "name": "Restore blocks from a revision, with a deleted paragraph",
      "setup": [
        { "wp": ["post", "create", "--post_title=Sourdough basics", "--post_status=publish", "--porcelain"], "save": "post" },
        ["post", "update", "{post}", "--post_content=<!-- wp:paragraph --><p>A starter is flour and water.</p><!-- /wp:paragraph -->\n\n<!-- wp:paragraph --><p>Tip: keep a spoon of starter back before you bake.</p><!-- /wp:paragraph -->"],
        ["post", "update", "{post}", "--post_content=<!-- wp:paragraph --><p>A starter is flour and water that has been fed for a week.</p><!-- /wp:paragraph -->"]
      ],
      "editor": "{post}",
      "steps": [
        { "click": "role=region[name=/Editor top bar/i] >> role=button[name=/Options/i]" },
        { "click": "role=menuitem[name=/Restore blocks from a revision/i]" },
        { "waitFor": ".abr-modal .abr-card" },
        { "evaluate": "Promise.all( document.getAnimations().map( ( animation ) => animation.finished ) )" }
      ],
      "cleanup": [["post", "delete", "{post}", "--force"]]
    },
    {
      "name": "Restore blocks from a revision, searching old text",
      "setup": [
        { "wp": ["post", "create", "--post_title=Sourdough basics", "--post_status=publish", "--porcelain"], "save": "post" },
        ["post", "update", "{post}", "--post_content=<!-- wp:paragraph --><p>A starter is flour and water.</p><!-- /wp:paragraph -->\n\n<!-- wp:paragraph --><p>Tip: keep a spoon of starter back before you bake.</p><!-- /wp:paragraph -->"],
