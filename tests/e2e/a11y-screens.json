        { "fill": "role=searchbox[name=/Find text in old revisions/i]", "value": "starter back" },
        { "waitFor": ".abr-result" },
        { "evaluate": "Promise.all( document.getAnimations().map( ( animation ) => animation.finished ) )" }
      ],
      "cleanup": [["post", "delete", "{post}", "--force"]]
    },
    {
      "name": "Restore one block from a revision, with its changes shown",
