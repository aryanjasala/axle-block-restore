        { "click": "role=menuitem[name=/Restore from a revision…/i]" },
        { "click": ".abr-card >> role=button[name=/Show changes/i]" },
        { "waitFor": ".abr-diff" },
        { "evaluate": "Promise.all( document.getAnimations().map( ( animation ) => animation.finished ) )" }
      ],
      "cleanup": [["post", "delete", "{post}", "--force"]]
