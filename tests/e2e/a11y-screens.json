    {
      "name": "Restore blocks from a revision, in the Site Editor on a template part",
      "setup": [
        ["eval", "foreach ( get_posts( array( 'post_type' => array( 'wp_template', 'wp_template_part' ), 'post_status' => 'any', 'numberposts' => -1 ) ) as $post ) { wp_delete_post( $post->ID, true ); }"],
        { "js": "a11y-seed.js", "call": "seedTemplatePart", "args": ["@rest", "{theme}"] }
      ],
      "url": "/wp-admin/site-editor.php?postType=wp_template_part&postId={theme}//header&canvas=edit",
      "steps": [
        { "waitFor": ".edit-site-layout" },
        { "evaluate": "window.wp.data.dispatch( 'core/preferences' ).set( 'core/edit-site', 'welcomeGuide', false ); window.wp.data.dispatch( 'core/preferences' ).set( 'core/edit-site', 'welcomeGuideTemplate', false ); window.wp.data.dispatch( 'core/preferences' ).set( 'core', 'welcomeGuide', false );" },
        { "press": "Escape" },
        { "click": "role=region[name=/Editor top bar/i] >> role=button[name=/Options/i]" },
        { "click": "role=menuitem[name=/Restore blocks from a revision/i]" },
        { "waitFor": ".abr-modal .abr-card" },
        { "evaluate": "Promise.all( document.getAnimations().map( ( animation ) => animation.finished ) )" }
      ],
      "cleanup": [
        ["eval", "foreach ( get_posts( array( 'post_type' => array( 'wp_template', 'wp_template_part' ), 'post_status' => 'any', 'numberposts' => -1 ) ) as $post ) { wp_delete_post( $post->ID, true ); }"]
      ]
    },
    {
